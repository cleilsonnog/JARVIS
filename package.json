{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "JARVIS - Assistente pessoal com IA",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i styles/tailwind.css -o public/tailwind.css --minify",
    "prestart": "npm run build:css",
    "start": "node server.js",
    "dev": "npm run build:css && (tailwindcss -i styles/tailwind.css -o public/tailwind.css --watch=always & node --watch server.js)"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
